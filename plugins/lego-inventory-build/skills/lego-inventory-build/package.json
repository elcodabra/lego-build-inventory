{
  "name": "lego-inventory-build",
  "version": "0.1.0",
  "description": "Design LEGO models from the parts you own, check them, and render booklet-style build films. Agent Skill + MCP server.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lego-mcp": "mcp/server.mjs"
  },
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "check": "node tools/check-model.cjs",
    "inv": "node tools/inventory.cjs",
    "snap": "node tools/snap.cjs",
    "render": "node tools/render.cjs",
    "mosaic": "node tools/mosaic.cjs",
    "mcp": "node mcp/server.mjs",
    "mcp:http": "node mcp/server.mjs --http",
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "playwright": "^1.55.0",
    "zod": "^3.25.0"
  }
}
